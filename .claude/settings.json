{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/harness/liveguard.py\" hook",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking the Live set before a write"
          }
        ]
      }
    ]
  }
}
